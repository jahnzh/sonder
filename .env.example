# Password for the `admin` account; other users are created in Settings → Users. Required by Docker Compose.
APP_PASSWORD=choose-a-long-password
# Set true behind HTTPS. Leave false for http://localhost.
COOKIE_SECURE=false
PORT=3001
# The app refuses media writes when this is on the system filesystem.
MEDIA_ROOT=/mnt/usb_4t_1/sonder
REQUIRE_MEDIA_MOUNT=true
# MEDIA_VOLUME_ID is generated by the setup script and checked against the HDD marker.
# scripts/setup-local-torrents.mjs configures these privately for the existing VPN.
TRANSMISSION_RPC_URL=http://172.17.0.2:9092/transmission/rpc
TRANSMISSION_USERNAME=sonder
TRANSMISSION_PASSWORD=
# This is the path as Transmission sees it, mapped to MEDIA_ROOT/complete.
TRANSMISSION_DOWNLOAD_DIR=/downloads/complete
# Optional: otherwise generated once in data/.encryption-key; back that file up.
# ENCRYPTION_KEY=
# Local known-text alignment; no paid API is used.
ALIGNMENT_WORKER_URL=http://127.0.0.1:3012
ALIGNMENT_WORKER_TOKEN=generate-a-random-private-token
# Optional worker time limit per request: min(MAX, BASE + PER_AUDIO_SECOND * audio seconds).
# ALIGNMENT_TIMEOUT_BASE_SECONDS=120
# ALIGNMENT_TIMEOUT_PER_AUDIO_SECOND=0.15
# ALIGNMENT_TIMEOUT_MAX_SECONDS=1200
# Content-Security-Policy mode: report-only (default), enforce or off. Violations are logged by POST /api/csp-report.
# CSP_MODE=report-only
