# Password for the `admin` account; other users are created in Settings → Users. Required by Docker Compose.
APP_PASSWORD=choose-a-long-password
# Set true behind HTTPS. Leave false for http://localhost.
COOKIE_SECURE=false
PORT=3001
# The app refuses media writes when this is on the system filesystem.
MEDIA_ROOT=/mnt/usb_4t_1/sonder
REQUIRE_MEDIA_MOUNT=true
# MEDIA_VOLUME_ID is generated by the setup script and checked against the HDD marker.
# scripts/setup-local-torrents.mjs configures these privately for the existing VPN.
TRANSMISSION_RPC_URL=http://172.17.0.2:9092/transmission/rpc
TRANSMISSION_USERNAME=sonder
TRANSMISSION_PASSWORD=
# This is the path as Transmission sees it, mapped to MEDIA_ROOT/complete.
TRANSMISSION_DOWNLOAD_DIR=/downloads/complete
# Optional: otherwise generated once in data/.encryption-key; back that file up.
# ENCRYPTION_KEY=
# Optional: outbound transactional email via Resend's HTTPS API. Without RESEND_API_KEY
# or EMAIL_FROM, account request alerts and invites are skipped and the admin gets the
# invite link to copy in Settings instead.
# RESEND_API_KEY=
# EMAIL_FROM=Sonder <you@your-domain>
# Where new account request alerts are delivered.
# ADMIN_EMAIL=you@your-domain
# Public base URL used in invite links; defaults to http://localhost:3001.
# APP_URL=https://your-domain
# Reading-sync alignment runs on the remote CTC pool (docs/CTC_WORKER_POOL.md); no paid API is used.
# The token must equal ALIGNMENT_WORKER_TOKEN in each pool worker's worker.env.
ALIGNMENT_POOL_ENABLED=1
ALIGNMENT_WORKER_TOKEN=generate-a-random-private-token
# 1 runs every full alignment as one whole-book job on the pool worker (#404); off until the
# whole-book engine has qualified. Turning it on rebuilds every map of the window engine.
# ALIGNMENT_BOOK_JOBS=1
# The worker's time limits (ALIGNMENT_TIMEOUT_*) and cache budget (ALIGNMENT_CTC_CACHE_BYTES)
# are set in each pool worker's worker.env, not here.
# Content-Security-Policy mode: report-only (default), enforce or off. Violations are logged by POST /api/csp-report.
# CSP_MODE=report-only
# AudiobookDB API key (#721): the catalogue. Made under account settings → API key on audiobookdb.org
# (needs a verified email). Settings → Connections shows it as set in the server's file.
# AUDIOBOOKDB_API_KEY=
