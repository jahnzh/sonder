# Caddy reverse-proxy configuration for Sonder CTC worker.
# Placed inside the <worker-domain> site block in /etc/caddy/Caddyfile.
# Strips /sonder-ctc prefix and forwards to local CTC worker on port 3012.
# Restricted to the production server IP allowlist.

<worker-domain> {
	handle_path /sonder-ctc/* {
		@prod remote_ip <prod-ip>
		handle @prod {
			reverse_proxy 127.0.0.1:3012
		}
		handle {
			respond 403
		}
	}
	# Other site configuration...
}
