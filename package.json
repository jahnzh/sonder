{
  "name": "sonder-audiobooks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:android": "bash scripts/test-android-emulator.sh",
    "test:mobile": "node scripts/test-mobile.mjs",
    "check": "node scripts/check-local.mjs",
    "ci:ssh": "bash scripts/ci-ssh.sh",
    "ci:deck": "bash scripts/ci-deck.sh",
    "backup": "node scripts/backup-db.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/vite": "^4.1.0",
    "aria-hidden": "^1.2.6",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.0",
    "dompurify": "3.4.17",
    "drizzle-orm": "^0.44.7",
    "epubjs": "0.3.93",
    "fast-xml-parser": "5.11.2",
    "fastify": "^5.6.1",
    "jszip": "3.10.2",
    "lucide-react": "^0.468.0",
    "music-metadata": "^12.3.2",
    "node-html-parser": "^7.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.6",
    "undici": "7.30.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
