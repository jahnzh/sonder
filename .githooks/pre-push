#!/usr/bin/env bash
set -euo pipefail

# What a push carries decides what runs here (#498, #504):
#   only documentation (docs/ or a markdown file)   nothing
#   anything else, or when it cannot be told          npm run build, then the committed check is
#                                                     started in the background for each pushed
#                                                     branch tip
# The unit and browser suites are not run here. The committed check runs them on the pushed
# commit itself, on the CI hosts (scripts/ci-run.sh).
#
#   SONDER_SKIP_PREPUSH=1   skip this hook altogether
#   SONDER_SKIP_PUSH_CI=1   run the build, do not start the committed check

# shellcheck source=.githooks/lib.sh
source "$(dirname "$0")/lib.sh"

# Git sends one line per ref update on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# Read them all first, so the push does not hang. The last line counts also without a newline.
updates=()
while IFS= read -r line || [[ -n "$line" ]]; do
  updates+=("$line")
done

if [[ "${SONDER_SKIP_PREPUSH:-}" == "1" ]]; then
  echo "Pre-push hook skipped (SONDER_SKIP_PREPUSH=1)."
  exit 0
fi

# An all-zero id stands for "no commit": a branch that is deleted, or one the remote does not have yet.
is_zero() { [[ "$1" =~ ^0+$ ]]; }

pushed=0    # a ref update carries commits
unknown=0   # what a ref update changes could not be listed
changed=0   # the pushed commits change a file
has_code=0  # a changed file is not documentation
to_check=() # "<sha> <branch>" of every pushed branch tip that needs the committed check

for line in ${updates[@]+"${updates[@]}"}; do
  read -r _local_ref local_sha remote_ref remote_sha <<<"$line" || true
  [[ -n "${local_sha:-}" ]] || continue
  # Deleting a branch pushes nothing.
  if is_zero "$local_sha"; then continue; fi
  pushed=1
  if [[ -z "${remote_sha:-}" ]] || is_zero "$remote_sha"; then
    # A new branch: compare with where it left main.
    base="$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi
  ref_needs_check=0
  # --no-renames: a file moved into docs/ is also a file removed from where it was. Without it git
  # lists only the new name, and moving code into docs/ would pass as documentation.
  # core.quotepath=off: a name with other than ASCII letters is listed as it is, not quoted.
  if [[ -z "$base" ]] || ! files="$(git -c core.quotepath=off diff --no-renames --name-only "$base" "$local_sha" -- 2>/dev/null)"; then
    unknown=1
    ref_needs_check=1
  else
    while IFS= read -r file; do
      [[ -n "$file" ]] || continue
      changed=1
      if ! is_documentation "$file"; then
        has_code=1
        ref_needs_check=1
      fi
    done <<<"$files"
  fi
  # Only a branch gets a committed check: a tag names a commit some branch carries.
  if [[ $ref_needs_check -eq 1 && "${remote_ref:-}" == refs/heads/* ]]; then
    to_check+=("$local_sha ${remote_ref#refs/heads/}")
  fi
done

if [[ $pushed -eq 0 ]]; then
  echo "Pre-push hook: no commits are pushed; nothing to check."
  exit 0
fi

if [[ $has_code -eq 0 && $unknown -eq 0 ]]; then
  if [[ $changed -eq 0 ]]; then
    echo "Pre-push hook: the pushed commits change no file; the build is not run."
  else
    echo "Pre-push hook: only documentation is pushed (docs/ or markdown); the build is not run."
  fi
  exit 0
fi

if [[ $has_code -eq 0 ]]; then
  echo "Pre-push hook: could not list what is pushed; running the build."
fi

if ! npm run build; then
  echo "Pre-push blocked: npm run build failed." >&2
  echo "Skip once with SONDER_SKIP_PREPUSH=1 git push" >&2
  exit 1
fi

# Start the committed check for each pushed branch tip. It runs on the CI hosts from a snapshot of
# the commit, so it does not wait for the push to finish, and nothing here can fail the push.
start_committed_checks() {
  local root helper runner artifacts item sha branch
  local -A seen=()
  [[ ${#to_check[@]} -gt 0 ]] || return 0
  if [[ "${SONDER_SKIP_PUSH_CI:-}" == "1" ]]; then
    echo "Pre-push hook: the committed check is not started (SONDER_SKIP_PUSH_CI=1)."
    return 0
  fi
  # A push made through scripts/ci-push.sh: the wrapper starts the check after the push.
  [[ "${SONDER_PUSH_CI_WRAPPER:-}" != "1" ]] || return 0
  # Git runs this hook in the root of the working tree.
  root="$(pwd)"
  helper="$root/scripts/lib/push-dispatch.sh"
  runner="${SONDER_PUSH_CI_RUNNER:-$root/scripts/ci-run.sh}"
  artifacts="${SONDER_PUSH_CI_ARTIFACTS:-$root/artifacts/ci}"
  if [[ ! -f "$helper" || ! -f "$runner" ]]; then
    echo "Pre-push hook: the committed check is not started (this checkout has no runner); run: npm run ci:run <sha>"
    return 0
  fi
  # shellcheck source=scripts/lib/push-dispatch.sh
  source "$helper"
  for item in "${to_check[@]}"; do
    sha="${item%% *}"
    branch="${item#* }"
    # Ids that are no commit of this repository cannot be checked.
    git rev-parse --verify --quiet "${sha}^{commit}" >/dev/null 2>&1 || continue
    if [[ -n "${seen[$sha]:-}" ]]; then
      echo "skipped $sha $branch (same commit as ${seen[$sha]})"
      continue
    fi
    seen[$sha]="$branch"
    push_dispatch_start "$runner" "$artifacts" "$sha" "$branch" scrub-git-env || true
  done
}
start_committed_checks || true
