#!/usr/bin/env bash
set -euo pipefail

# Git sends ref updates on stdin; discard them so the push does not hang.
while IFS= read -r _; do
  :
done

if [[ "${SONDER_SKIP_PREPUSH:-}" == "1" ]]; then
  echo "Pre-push hook skipped (SONDER_SKIP_PREPUSH=1)."
  exit 0
fi

if ! npm run build; then
  echo "Pre-push blocked: npm run build failed." >&2
  echo "Skip once with SONDER_SKIP_PREPUSH=1 git push" >&2
  exit 1
fi

# Git exports repository and index paths to hooks. Test fixtures create their own
# repositories, so none of that context may reach the test process or its children.
if ! (
  unset_git_env=()
  while IFS= read -r -d '' entry; do
    case $entry in
      GIT_*=*) unset_git_env+=(-u "${entry%%=*}") ;;
    esac
  done < <(env -0)
  env "${unset_git_env[@]}" npm test
); then
  echo "Pre-push blocked: npm test failed." >&2
  echo "Skip once with SONDER_SKIP_PREPUSH=1 git push" >&2
  exit 1
fi
