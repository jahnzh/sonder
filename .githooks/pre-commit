#!/usr/bin/env bash
set -euo pipefail

if [[ "${SONDER_SKIP_PRECOMMIT:-}" == "1" ]]; then
  echo "Pre-commit hook skipped (SONDER_SKIP_PRECOMMIT=1)."
  exit 0
fi

if ! npx tsc --noEmit; then
  echo "Pre-commit blocked: npx tsc --noEmit failed." >&2
  echo "Skip once with SONDER_SKIP_PRECOMMIT=1 git commit" >&2
  exit 1
fi
